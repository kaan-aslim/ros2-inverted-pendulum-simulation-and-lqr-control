<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share inverted_pendulum_description)/urdf/inverted_pendulum.urdf.xacro" />
    <let name="world_path"
         value="$(find-pkg-share inverted_pendulum_gazebo)/worlds/inverted_pendulum_world.sdf" />
    <let name="gazebo_config_path"
         value="$(find-pkg-share inverted_pendulum_bringup)/config/gazebo_bridge.yaml" />
    <let name="rviz_config_path"
         value="$(find-pkg-share inverted_pendulum_description)/rviz/urdf_config.rviz" />

    <node pkg="robot_state_publisher" 
          exec="robot_state_publisher">
            <param name="robot_description"
                   value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" 
             value="-r $(var world_path)" />
    </include>

    <node pkg="ros_gz_sim" 
          exec="create" 
          args="-topic robot_description" />

    <node pkg="ros_gz_bridge" 
          exec="parameter_bridge">
            <param name="config_file" 
                   value="$(var gazebo_config_path)" />
    </node>

    <node pkg="inverted_pendulum_control"
      exec="control_node"
      name="inverted_pendulum_controller"
      output="screen" />

    <node pkg="rviz2" 
          exec="rviz2" 
          output="screen" 
          args="-d $(var rviz_config_path)" />

</launch>